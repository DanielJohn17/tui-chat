# ==============================================================================
# LineTalk Environment Configuration Template
# ==============================================================================
# Copy this file to .env before running the application:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL Connection URI (Neon cloud DB or local PostgreSQL instance)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tui?sslmode=disable

# Alternatively, database components can be specified individually:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=tui
# DB_SSLMODE=disable

# ------------------------------------------------------------------------------
# Server & Environment Settings
# ------------------------------------------------------------------------------
PORT=8080
GO_ENV=development

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# JWT secret used for signing user authentication tokens (min 32 characters in production)
JWT_SECRET_KEY=your_development_secret_key_here
# JWT token validity in seconds (e.g. 259200 = 3 days)
JWT_EXP=259200

# Client application shared secret (required for LineTalk build & API authentication)
APP_SHARED_SECRET=your_development_app_secret_here

# ------------------------------------------------------------------------------
# TUI Client Settings (Optional overrides)
# ------------------------------------------------------------------------------
# API URL target for local development (defaults to http://localhost:8080)
# API_URL=http://localhost:8080
